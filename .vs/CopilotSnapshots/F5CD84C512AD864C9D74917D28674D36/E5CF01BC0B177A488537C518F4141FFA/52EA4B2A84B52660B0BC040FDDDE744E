using Application.DTOs.User;
using Application.Interfaces;
using Application.Mappers;
using Domain.Entities;
using Domain.Interfaces;

namespace Application.Services
{
    public class UserService : IUserService
    {
        private readonly IUserRepo _userRepo;

        public UserService(IUserRepo userRepo)
        {
            _userRepo = userRepo;
        }

        public async Task<bool> ActivateUserAsync(int id)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(id);

            var user = await _userRepo.GetByIdAsync(id);

            if (user is null)
                throw new KeyNotFoundException($"User with ID {id} does not exist.");

            if (!user.IsActive)
            {
                user.IsActive = true;
                await _userRepo.UpdateAsync(user);
            }

            return true;
        }

        public async Task<User?> AddAsync(AddUserDto newUser)
        {
            ArgumentNullException.ThrowIfNull(newUser);

            if (await _userRepo.ExistsByPhoneAsync(newUser.PhoneNumber)
                || await _userRepo.ExistsByEmailAsync(newUser.Email)) 
            {
                throw new ArgumentException("A user with the same phone or email already exists.");
            }

            return await _userRepo.AddAsync(newUser.ToEntity());
        }

        public async Task<bool> DeactivateUserAsync(int id)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(id);

            var user = await _userRepo.GetByIdAsync(id);

            if (user is null)
                throw new KeyNotFoundException($"User with ID {id} does not exist.");

            if (user.IsActive)
            {
                user.IsActive = false;
                await _userRepo.UpdateAsync(user);
            }

            return true;
        }

        public async Task<ICollection<User>> GetAllAsync()
        {
            return await _userRepo.GetAllAsync();
        }

        public async Task<User?> GetByIdAsync(int id)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(id);

            return await _userRepo.GetByIdAsync(id);
        }

        public async Task<bool> UpdateEmailAsync(int id, UpdateEmailDto emailDto)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(id);
            ArgumentNullException.ThrowIfNull(emailDto);

            var user = await _userRepo.GetByIdAsync(id);

            if (user is null)
                throw new KeyNotFoundException($"User with ID {id} does not exist.");

            if (await _userRepo.ExistsByEmailAsync(emailDto.NewEmail))
                    throw new ArgumentException("A user with the same email already exists.");

            // This is a placeholder for the email verification logic.

            user.Email = emailDto.NewEmail;

            return await _userRepo.UpdateAsync(user);

        }

        public async Task<bool> UpdatePasswordAsync(int id, UpdatePasswordDto passwordDto)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(id);
            ArgumentNullException.ThrowIfNull(passwordDto);

            var user = await _userRepo.GetByIdAsync(id);

            if (user is null)
                throw new KeyNotFoundException($"User with ID {id} does not exist.");

            if (!BCrypt.Net.BCrypt.Verify(passwordDto.CurrentPassword, user.PasswordHash))
                throw new ArgumentException("Current password is incorrect.");

            user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(passwordDto.NewPassword);

            return await _userRepo.UpdateAsync(user);
        }

        public async Task<bool> UpdateProfileAsync(int id, UpdateProfileDto profileDto)
        {
            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(id);
            ArgumentNullException.ThrowIfNull(profileDto);

            var user = await _userRepo.GetByIdAsync(id);

            if (user is null)
                throw new KeyNotFoundException($"User with ID {id} does not exist.");

            user.FirstName = profileDto.FirstName;
            user.LastName = profileDto.LastName;
            user.Phone = profileDto.PhoneNumber;

            return await _userRepo.UpdateAsync(user);
        }
    }
}
